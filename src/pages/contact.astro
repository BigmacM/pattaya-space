---
import Layout from '../layouts/Layout.astro';
import businessData from '../../content/business.json';

const { businessInfo, contact } = businessData;
---

<Layout
  title="Contact | Pattaya Space"
  description="Get in touch with Pattaya Space. Book a tour, inquire about memberships, or just say hello. Located in central Pattaya."
>
  <!-- Hero Section -->
  <section class="page-hero pt-32 pb-20">
    <div class="page-hero-content">
      <span class="font-mono text-sm text-cyan uppercase tracking-wider mb-4 block">// GET IN TOUCH</span>
      <h1 class="heading-xl text-silver mb-6">{contact.title}</h1>
      <p class="body-lg max-w-2xl mx-auto">{contact.subtitle}</p>
    </div>

    <!-- Ambient glow -->
    <div class="absolute top-1/2 left-1/3 w-96 h-96 bg-cyan/10 rounded-full blur-3xl"></div>
  </section>

  <!-- Contact Section -->
  <section class="section-padding bg-charcoal relative overflow-hidden">
    <!-- Background glow -->
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-turquoise/5 rounded-full blur-3xl"></div>

    <div class="container-custom relative">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Contact Form -->
        <div class="glass-card p-8 md:p-10">
          <h2 class="font-serif text-2xl font-semibold text-silver mb-2 tracking-wide">Send us a message</h2>
          <p class="text-silver-300 font-sans text-sm mb-8">{contact.contactMessage}</p>

          <form id="contact-form" class="space-y-6">
            <div>
              <label for="name" class="block font-sans text-sm font-medium text-silver-200 mb-2">
                Your Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 bg-charcoal border border-white/10 rounded-xl font-sans text-silver placeholder-silver-400 focus:outline-none focus:ring-2 focus:ring-cyan focus:border-transparent transition-all"
                placeholder="John Doe"
              />
            </div>

            <div>
              <label for="email" class="block font-sans text-sm font-medium text-silver-200 mb-2">
                Email Address
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 bg-charcoal border border-white/10 rounded-xl font-sans text-silver placeholder-silver-400 focus:outline-none focus:ring-2 focus:ring-cyan focus:border-transparent transition-all"
                placeholder="john@example.com"
              />
            </div>

            <div>
              <label for="interest" class="block font-sans text-sm font-medium text-silver-200 mb-2">
                I'm Interested In
              </label>
              <select
                id="interest"
                name="interest"
                required
                class="w-full px-4 py-3 bg-charcoal border border-white/10 rounded-xl font-sans text-silver focus:outline-none focus:ring-2 focus:ring-cyan focus:border-transparent transition-all appearance-none cursor-pointer"
              >
                <option value="">Select an option</option>
                <option value="day-pass">Day Pass</option>
                <option value="hot-desk">Hot Desk Membership</option>
                <option value="dedicated">Dedicated Desk</option>
                <option value="virtual">Virtual Office</option>
                <option value="private">Private Office</option>
                <option value="tour">Just a Tour</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="message" class="block font-sans text-sm font-medium text-silver-200 mb-2">
                Message (Optional)
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                class="w-full px-4 py-3 bg-charcoal border border-white/10 rounded-xl font-sans text-silver placeholder-silver-400 focus:outline-none focus:ring-2 focus:ring-cyan focus:border-transparent transition-all resize-none"
                placeholder="Tell us about your needs..."
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full btn-primary"
            >
              Send Message
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>

          <!-- Success message (hidden by default) -->
          <div id="success-message" class="hidden text-center py-12">
            <div class="w-20 h-20 bg-cyan/20 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-10 h-10 text-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="font-serif text-2xl font-semibold text-silver mb-2">Thank You!</h3>
            <p class="text-silver-300 font-sans">We'll be in touch within 24 hours.</p>
          </div>
        </div>

        <!-- Contact Info -->
        <div class="space-y-8">
          <!-- Contact Cards -->
          <a
            href={`tel:${businessInfo.phone.replace(/\s/g, '')}`}
            class="glass-card p-6 flex items-center gap-4 group hover:border-cyan/30 transition-all"
          >
            <div class="w-14 h-14 bg-cyan/20 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-cyan group-hover:text-charcoal transition-all text-cyan">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="font-mono text-xs text-silver-400 uppercase tracking-wider mb-1">Call us</p>
              <p class="font-sans text-lg text-silver font-semibold">{businessInfo.phone}</p>
            </div>
          </a>

          <a
            href={`mailto:${businessInfo.email}`}
            class="glass-card p-6 flex items-center gap-4 group hover:border-cyan/30 transition-all"
          >
            <div class="w-14 h-14 bg-cyan/20 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-cyan group-hover:text-charcoal transition-all text-cyan">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="font-mono text-xs text-silver-400 uppercase tracking-wider mb-1">Email us</p>
              <p class="font-sans text-lg text-silver font-semibold break-all">{businessInfo.email}</p>
            </div>
          </a>

          <a
            href={businessInfo.googleMapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="glass-card p-6 flex items-start gap-4 group hover:border-cyan/30 transition-all"
          >
            <div class="w-14 h-14 bg-cyan/20 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-cyan group-hover:text-charcoal transition-all text-cyan">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="font-mono text-xs text-silver-400 uppercase tracking-wider mb-1">Visit us</p>
              <p class="font-sans text-silver mb-2">{businessInfo.address}</p>
              <span class="inline-flex items-center gap-1 text-cyan font-sans text-sm group-hover:text-cyan-400">
                Get Directions
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>

          <!-- Hours -->}
          <div class="glass-card p-6">
            <p class="font-mono text-xs text-silver-400 uppercase tracking-wider mb-4">// HOURS</p>
            <div class="space-y-3">
              {businessInfo.hours.map((schedule) => (
                <div class="flex justify-between items-center">
                  <span class="font-sans text-silver-200">{schedule.days}</span>
                  <span class="font-mono text-cyan">{schedule.time}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="bg-charcoal-900">
    <div class="h-[400px] w-full">
      <iframe
        src={contact.mapEmbedUrl}
        width="100%"
        height="100%"
        style="border:0; filter: grayscale(0.8) contrast(1.1);"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Pattaya Space Location"
      ></iframe>
    </div>
  </section>
</Layout>

<script is:inline>
  const form = document.getElementById('contact-form');
  const successMessage = document.getElementById('success-message');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const submitBtn = form.querySelector('button[type="submit"]');
    if (submitBtn) {
      submitBtn.innerHTML = `
        <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Sending...
      `;
      submitBtn.setAttribute('disabled', 'true');
    }

    // Simulate form submission
    await new Promise(resolve => setTimeout(resolve, 1500));

    form.classList.add('hidden');
    successMessage?.classList.remove('hidden');
  });
</script>
