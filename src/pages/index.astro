---
import Layout from '../layouts/Layout.astro';
import WaveDivider from '../components/WaveDivider.astro';

// Import React components
import Hero from '../components/sections/Hero';
import About from '../components/sections/About';
import Pricing from '../components/sections/Pricing';
import Amenities from '../components/sections/Amenities';
import Contact from '../components/sections/Contact';

// Load business data
import businessData from '../../content/business.json';

const {
  businessInfo,
  hero,
  about,
  pricing,
  amenities,
  contact,
  seo,
} = businessData;
---

<Layout title={seo.title} description={seo.description}>
  <!-- Hero Section -->
  <Hero
    client:load
    headline={hero.headline}
    subheadline={hero.subheadline}
    ctaText={hero.ctaText}
    ctaLink={hero.ctaLink}
  />

  <!-- About Section -->
  <About
    client:visible
    phase={about.phase}
    title={about.title}
    subtitle={about.subtitle}
    description={about.description}
    highlights={about.highlights}
  />

  <!-- Wave divider -->
  <WaveDivider fillColor="#FAF0D4" bgColor="#FDF8E7" variant="curve" />

  <!-- Pricing Section -->
  <Pricing
    client:visible
    title={pricing.title}
    subtitle={pricing.subtitle}
    tiers={pricing.tiers}
  />

  <!-- Amenities Section -->
  <Amenities
    client:visible
    title={amenities.title}
    subtitle={amenities.subtitle}
    items={amenities.items}
  />

  <!-- Wave divider back to light -->
  <WaveDivider fillColor="#FDF8E7" bgColor="#064E3B" variant="wave" flip />

  <!-- Contact Section -->
  <Contact
    client:visible
    title={contact.title}
    subtitle={contact.subtitle}
    contactMessage={contact.contactMessage}
    businessInfo={{
      phone: businessInfo.phone,
      email: businessInfo.email,
      address: businessInfo.address,
      googleMapsLink: businessInfo.googleMapsLink,
    }}
    mapEmbedUrl={contact.mapEmbedUrl}
  />
</Layout>
