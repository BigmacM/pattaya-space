---
import Layout from '../layouts/Layout.astro';

// Import React components
import Hero from '../components/sections/Hero';
import FeaturedPricing from '../components/sections/FeaturedPricing';
import StatsBar from '../components/sections/StatsBar';
import CTASection from '../components/sections/CTASection';

// Load business data
import businessData from '../../content/business.json';

const { businessInfo, hero, pricing, seo } = businessData;

// Get featured tiers (first 3)
const featuredTiers = pricing.tiers.slice(0, 3);
---

<Layout title={seo.title} description={seo.description}>
  <!-- Hero Section with Broken Grid -->
  <Hero
    client:load
    headline={hero.headline}
    subheadline={hero.subheadline}
    ctaText={hero.ctaText}
    ctaLink={hero.ctaLink}
  />

  <!-- Stats Bar -->
  <StatsBar client:visible />

  <!-- Featured Pricing Preview -->
  <FeaturedPricing
    client:visible
    title="Flexible Memberships"
    subtitle="Choose the plan that fits your workflow"
    tiers={featuredTiers}
  />

  <!-- CTA Section -->
  <CTASection client:visible />
</Layout>
