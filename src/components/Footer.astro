---
import businessData from '../../content/business.json';
const { businessInfo, socials } = businessData;
---

<footer class="bg-charcoal-900 text-silver relative overflow-hidden">
  <!-- Decorative glow orbs -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-cyan/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-1/4 w-64 h-64 bg-turquoise/10 rounded-full blur-3xl"></div>

  <div class="container-custom py-16 relative">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-6 group">
          <div class="w-12 h-12 bg-gradient-to-br from-cyan to-turquoise rounded-lg flex items-center justify-center transform group-hover:scale-110 transition-all duration-300 shadow-glow">
            <span class="text-charcoal font-serif font-bold text-2xl">P</span>
          </div>
          <span class="font-serif text-2xl font-semibold text-silver tracking-wide">
            {businessInfo.name}
          </span>
        </a>
        <p class="text-silver-300 font-sans leading-relaxed">
          {businessInfo.tagline}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-serif text-xl font-semibold text-silver mb-6 tracking-wide">Explore</h4>
        <ul class="space-y-3">
          <li>
            <a href="/" class="text-silver-300 hover:text-cyan transition-colors duration-300 font-sans">Home</a>
          </li>
          <li>
            <a href="/about" class="text-silver-300 hover:text-cyan transition-colors duration-300 font-sans">About</a>
          </li>
          <li>
            <a href="/pricing" class="text-silver-300 hover:text-cyan transition-colors duration-300 font-sans">Pricing</a>
          </li>
          <li>
            <a href="/amenities" class="text-silver-300 hover:text-cyan transition-colors duration-300 font-sans">Amenities</a>
          </li>
          <li>
            <a href="/contact" class="text-silver-300 hover:text-cyan transition-colors duration-300 font-sans">Contact</a>
          </li>
        </ul>
      </div>

      <!-- Hours & Contact -->
      <div>
        <h4 class="font-serif text-xl font-semibold text-silver mb-6 tracking-wide">Hours</h4>
        <ul class="space-y-3 mb-8">
          {businessInfo.hours.map((schedule) => (
            <li class="flex justify-between text-silver-300 font-sans">
              <span>{schedule.days}</span>
              <span class="font-mono text-cyan text-sm">{schedule.time}</span>
            </li>
          ))}
        </ul>

        <h4 class="font-serif text-lg font-semibold text-silver mb-4 tracking-wide">Contact</h4>
        <ul class="space-y-2">
          <li>
            <a
              href={`tel:${businessInfo.phone.replace(/\s/g, '')}`}
              class="text-silver-300 hover:text-cyan transition-colors font-mono text-sm"
            >
              {businessInfo.phone}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${businessInfo.email}`}
              class="text-silver-300 hover:text-cyan transition-colors font-mono text-sm"
            >
              {businessInfo.email}
            </a>
          </li>
        </ul>
      </div>

      <!-- Location & Social -->
      <div>
        <h4 class="font-serif text-xl font-semibold text-silver mb-6 tracking-wide">Location</h4>
        <a
          href={businessInfo.googleMapsLink}
          target="_blank"
          rel="noopener noreferrer"
          class="block text-silver-300 hover:text-cyan transition-colors leading-relaxed font-sans mb-8"
        >
          {businessInfo.address}
          <span class="block mt-2 text-cyan text-sm font-medium">Get Directions →</span>
        </a>

        <h4 class="font-serif text-lg font-semibold text-silver mb-4 tracking-wide">Follow</h4>
        <div class="flex gap-3">
          {socials.facebook && (
            <a
              href={socials.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 bg-gunmetal rounded-lg flex items-center justify-center hover:bg-cyan hover:text-charcoal transition-all duration-300 text-silver-300"
              aria-label="Facebook"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
          {socials.instagram && (
            <a
              href={socials.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 bg-gunmetal rounded-lg flex items-center justify-center hover:bg-cyan hover:text-charcoal transition-all duration-300 text-silver-300"
              aria-label="Instagram"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          )}
          {socials.line && (
            <a
              href={socials.line}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 bg-gunmetal rounded-lg flex items-center justify-center hover:bg-cyan hover:text-charcoal transition-all duration-300 text-silver-300"
              aria-label="LINE"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.349 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-16 pt-8 border-t border-white/5">
      <p class="text-silver-400 text-sm font-sans text-center md:text-left">
        © {new Date().getFullYear()} {businessInfo.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
