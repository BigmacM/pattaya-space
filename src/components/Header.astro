---
import businessData from '../../content/business.json';
const { businessInfo } = businessData;

// Get current path for active state
const currentPath = Astro.url.pathname;
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
>
  <nav class="container-custom">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 bg-gradient-to-br from-cyan to-turquoise rounded-lg flex items-center justify-center transform group-hover:scale-110 transition-all duration-300 shadow-glow">
          <span class="text-charcoal font-serif font-bold text-xl">P</span>
        </div>
        <span class="font-serif text-xl font-semibold text-silver hidden sm:block tracking-wide">
          {businessInfo.name}
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        <a href="/" class:list={["nav-link", { active: currentPath === '/' }]}>Home</a>
        <a href="/about" class:list={["nav-link", { active: currentPath === '/about' || currentPath === '/about/' }]}>About</a>
        <a href="/pricing" class:list={["nav-link", { active: currentPath === '/pricing' || currentPath === '/pricing/' }]}>Pricing</a>
        <a href="/amenities" class:list={["nav-link", { active: currentPath === '/amenities' || currentPath === '/amenities/' }]}>Amenities</a>
        <a href="/contact" class:list={["nav-link", { active: currentPath === '/contact' || currentPath === '/contact/' }]}>Contact</a>
        <a href="/contact" class="btn-primary text-sm py-3 px-6">
          Book Now
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden w-10 h-10 flex flex-col items-center justify-center gap-1.5 group"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden fixed inset-0 top-20 bg-charcoal/95 backdrop-blur-lg transform translate-x-full transition-transform duration-300 ease-out"
  >
    <nav class="container-custom py-8">
      <div class="flex flex-col gap-6">
        <a href="/" class:list={["mobile-nav-link", { active: currentPath === '/' }]}>Home</a>
        <a href="/about" class:list={["mobile-nav-link", { active: currentPath === '/about' || currentPath === '/about/' }]}>About</a>
        <a href="/pricing" class:list={["mobile-nav-link", { active: currentPath === '/pricing' || currentPath === '/pricing/' }]}>Pricing</a>
        <a href="/amenities" class:list={["mobile-nav-link", { active: currentPath === '/amenities' || currentPath === '/amenities/' }]}>Amenities</a>
        <a href="/contact" class:list={["mobile-nav-link", { active: currentPath === '/contact' || currentPath === '/contact/' }]}>Contact</a>
        <a href="/contact" class="btn-primary text-center mt-4">
          Book Now
        </a>
      </div>

      <!-- Mobile Contact Info -->
      <div class="mt-12 pt-8 border-t border-white/10">
        <p class="font-mono text-sm text-silver-300 mb-2">Open Daily</p>
        <p class="font-sans text-cyan">8:00 AM - 2:00 AM</p>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-link {
    @apply font-sans text-silver-200 hover:text-cyan transition-colors duration-300 relative;
  }

  .nav-link::after {
    content: '';
    @apply absolute -bottom-1 left-0 w-0 h-0.5 bg-cyan transition-all duration-300;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    @apply w-full;
  }

  .nav-link.active {
    @apply text-cyan;
  }

  .mobile-nav-link {
    @apply font-serif text-3xl text-silver hover:text-cyan transition-colors duration-300 tracking-wide;
  }

  .mobile-nav-link.active {
    @apply text-cyan;
  }

  .hamburger-line {
    @apply w-6 h-0.5 bg-silver transition-all duration-300 origin-center;
  }

  .menu-open .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
    @apply bg-cyan;
  }

  .menu-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .menu-open .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
    @apply bg-cyan;
  }

  /* Glassmorphism on scroll */
  header.scrolled {
    @apply glass-nav;
  }

  /* Initial transparent state for hero pages */
  header:not(.scrolled) {
    background: transparent;
  }
</style>

<script>
  // Header scroll effect
  const header = document.getElementById('header');

  const handleScroll = () => {
    if (window.scrollY > 50) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  };

  window.addEventListener('scroll', handleScroll);
  handleScroll();

  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenuBtn.classList.toggle('menu-open');
    mobileMenuBtn.setAttribute('aria-expanded', String(isOpen));
    mobileMenu?.classList.toggle('translate-x-full');
    mobileMenu?.classList.toggle('translate-x-0');
    document.body.classList.toggle('overflow-hidden');
  });

  // Close mobile menu on link click
  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenuBtn?.classList.remove('menu-open');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
      mobileMenu?.classList.add('translate-x-full');
      mobileMenu?.classList.remove('translate-x-0');
      document.body.classList.remove('overflow-hidden');
    });
  });
</script>
