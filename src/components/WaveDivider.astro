---
interface Props {
  fillColor?: string;
  bgColor?: string;
  flip?: boolean;
  variant?: 'wave' | 'curve' | 'tilt';
}

const {
  fillColor = '#FDF8E7',
  bgColor = 'transparent',
  flip = false,
  variant = 'wave'
} = Astro.props;
---

<div
  class:list={[
    'w-full overflow-hidden',
    { 'rotate-180': flip }
  ]}
  style={`background-color: ${bgColor};`}
>
  {variant === 'wave' && (
    <svg
      viewBox="0 0 1440 120"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-auto block"
      preserveAspectRatio="none"
    >
      <path
        d="M0 120L48 108C96 96 192 72 288 66C384 60 480 72 576 78C672 84 768 84 864 78C960 72 1056 60 1152 60C1248 60 1344 72 1392 78L1440 84V0H1392C1344 0 1248 0 1152 0C1056 0 960 0 864 0C768 0 672 0 576 0C480 0 384 0 288 0C192 0 96 0 48 0H0V120Z"
        fill={fillColor}
      />
    </svg>
  )}

  {variant === 'curve' && (
    <svg
      viewBox="0 0 1440 100"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-auto block"
      preserveAspectRatio="none"
    >
      <path
        d="M0 100C240 100 480 0 720 0C960 0 1200 100 1440 100V0H0V100Z"
        fill={fillColor}
      />
    </svg>
  )}

  {variant === 'tilt' && (
    <svg
      viewBox="0 0 1440 60"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full h-auto block"
      preserveAspectRatio="none"
    >
      <path
        d="M0 60L1440 0V60H0Z"
        fill={fillColor}
      />
    </svg>
  )}
</div>
